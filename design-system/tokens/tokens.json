{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "WAXR Academy Design System",
    "version": "1.0.0",
    "description": "Online opleiding voor vrouwen die professioneel waxspecialist worden en binnen circa 3 maanden hun eigen winstgevende waxsalon vanuit huis opzetten.",
    "primaryColor": "#8F7761",
    "typeface": "Inter",
    "baseUnit": 4
  },
  "color": {
    "brand": {
      "50":  { "value": "#F6F4F2", "type": "color" },
      "100": { "value": "#EBE7E3", "type": "color" },
      "200": { "value": "#D9D1C9", "type": "color" },
      "300": { "value": "#C5B8AD", "type": "color" },
      "400": { "value": "#AC9A8A", "type": "color" },
      "500": { "value": "#9C8774", "type": "color" },
      "600": { "value": "#8F7761", "type": "color", "description": "Primary brand color — taupe. Wordmark, headlines, emphasis. Not used for CTA buttons — see accent." },
      "700": { "value": "#735F4D", "type": "color", "description": "Primary hover/pressed" },
      "800": { "value": "#5A4B3B", "type": "color" },
      "900": { "value": "#44382B", "type": "color" }
    },
    "accent": {
      "100": { "value": "#FFE9D6", "type": "color" },
      "600": { "value": "#FF914D", "type": "color", "description": "The single CTA/action color — real shipped orange from the lead-magnet guide and Instagram caption bubbles. Action-only, never decorative, never paired with brand-600 as a second 'primary'." },
      "700": { "value": "#E87A33", "type": "color", "description": "Accent hover/pressed" }
    },
    "ink": {
      "100": { "value": "#F2F2F2", "type": "color" },
      "200": { "value": "#E1E1E1", "type": "color" },
      "300": { "value": "#C3C3C3", "type": "color" },
      "400": { "value": "#9F9F9F", "type": "color" },
      "500": { "value": "#7B7B7B", "type": "color" },
      "600": { "value": "#595959", "type": "color" },
      "700": { "value": "#3F3F3F", "type": "color" },
      "900": { "value": "#2A2A2A", "type": "color", "description": "Primary text color — charcoal, not pure black" }
    },
    "paper":     { "value": "#F2EFEB", "type": "color", "description": "Page background — warm cream, confirmed across the 22-page lead-magnet guide and both Instagram carousels" },
    "surface":   { "value": "#FFFFFF", "type": "color", "description": "Cards, modals, product UI canvas — pure white, lifted off the cream paper" },
    "line":      { "value": "#E2DDD5", "type": "color", "description": "Dividers on paper" },
    "line-soft": { "value": "#ECE8E2", "type": "color" },
    "success": {
      "100": { "value": "#E2F5EC", "type": "color" },
      "600": { "value": "#1F9D6B", "type": "color" }
    },
    "warn": {
      "100": { "value": "#FBF2DC", "type": "color" },
      "600": { "value": "#C08415", "type": "color" }
    },
    "danger": {
      "100": { "value": "#FAE4E2", "type": "color" },
      "600": { "value": "#C8382F", "type": "color" }
    },
    "info": {
      "100": { "value": "#EBE7E3", "type": "color" },
      "600": { "value": "#8F7761", "type": "color" }
    }
  },
  "font": {
    "family": {
      "sans":    { "value": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif", "type": "fontFamily", "description": "Body copy, UI, captions" },
      "display": { "value": "'Playfair Display', ui-serif, Georgia, serif", "type": "fontFamily", "description": "Headlines only — matches the serif used across the real lead-magnet guide and Instagram carousels. Open-source stand-in for the logo's unlicensed Didone serif; swap if the licensed name surfaces." },
      "mono":    { "value": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace", "type": "fontFamily" }
    },
    "weight": {
      "regular":  { "value": 400, "type": "fontWeight" },
      "medium":   { "value": 500, "type": "fontWeight" },
      "semibold": { "value": 600, "type": "fontWeight" },
      "bold":     { "value": 700, "type": "fontWeight" }
    }
  },
  "size": {
    "display-xl": { "value": "72px", "type": "dimension", "lineHeight": "80px", "weight": 600, "tracking": "-0.01em", "family": "display" },
    "display-lg": { "value": "56px", "type": "dimension", "lineHeight": "64px", "weight": 600, "tracking": "-0.01em", "family": "display" },
    "h1":         { "value": "40px", "type": "dimension", "lineHeight": "48px", "weight": 600, "tracking": "-0.005em", "family": "display" },
    "h2":         { "value": "32px", "type": "dimension", "lineHeight": "40px", "weight": 600, "tracking": "-0.005em", "family": "display" },
    "h3":         { "value": "24px", "type": "dimension", "lineHeight": "32px", "weight": 600, "tracking": "0em", "family": "display" },
    "h4":         { "value": "20px", "type": "dimension", "lineHeight": "28px", "weight": 600, "tracking": "0em", "family": "sans" },
    "body-lg":    { "value": "18px", "type": "dimension", "lineHeight": "28px", "weight": 400, "family": "sans" },
    "body-md":    { "value": "16px", "type": "dimension", "lineHeight": "24px", "weight": 400, "family": "sans" },
    "body-sm":    { "value": "14px", "type": "dimension", "lineHeight": "20px", "weight": 400, "family": "sans" },
    "caption":    { "value": "12px", "type": "dimension", "lineHeight": "16px", "weight": 500, "family": "sans" },
    "overline":   { "value": "11px", "type": "dimension", "lineHeight": "16px", "weight": 600, "tracking": "+0.06em", "transform": "uppercase", "family": "sans" },
    "code":       { "value": "14px", "type": "dimension", "lineHeight": "20px", "weight": 400, "family": "mono" }
  },
  "space": {
    "0":   { "value": "0px",   "type": "dimension" },
    "0_5": { "value": "2px",   "type": "dimension" },
    "1":   { "value": "4px",   "type": "dimension" },
    "1_5": { "value": "6px",   "type": "dimension" },
    "2":   { "value": "8px",   "type": "dimension" },
    "3":   { "value": "12px",  "type": "dimension" },
    "4":   { "value": "16px",  "type": "dimension" },
    "5":   { "value": "20px",  "type": "dimension" },
    "6":   { "value": "24px",  "type": "dimension" },
    "8":   { "value": "32px",  "type": "dimension" },
    "10":  { "value": "40px",  "type": "dimension" },
    "12":  { "value": "48px",  "type": "dimension" },
    "16":  { "value": "64px",  "type": "dimension" },
    "20":  { "value": "80px",  "type": "dimension" },
    "24":  { "value": "96px",  "type": "dimension" },
    "32":  { "value": "128px", "type": "dimension" },
    "40":  { "value": "160px", "type": "dimension" }
  },
  "radius": {
    "none": { "value": "0px",    "type": "dimension" },
    "xs":   { "value": "4px",    "type": "dimension" },
    "sm":   { "value": "6px",    "type": "dimension" },
    "md":   { "value": "10px",   "type": "dimension" },
    "lg":   { "value": "16px",   "type": "dimension" },
    "xl":   { "value": "24px",   "type": "dimension" },
    "full": { "value": "9999px", "type": "dimension" }
  },
  "shadow": {
    "none": { "value": "none", "type": "shadow" },
    "xs":   { "value": "0 1px 2px rgba(42, 42, 42, 0.04)", "type": "shadow" },
    "sm":   { "value": "0 1px 3px rgba(42, 42, 42, 0.06), 0 1px 2px rgba(42, 42, 42, 0.04)", "type": "shadow" },
    "md":   { "value": "0 4px 12px rgba(42, 42, 42, 0.06), 0 2px 4px rgba(42, 42, 42, 0.04)", "type": "shadow" },
    "lg":   { "value": "0 12px 32px rgba(42, 42, 42, 0.08), 0 4px 8px rgba(42, 42, 42, 0.04)", "type": "shadow" },
    "xl":   { "value": "0 24px 48px rgba(42, 42, 42, 0.10), 0 8px 16px rgba(42, 42, 42, 0.06)", "type": "shadow" }
  },
  "motion": {
    "duration": {
      "xs": { "value": "80ms",  "type": "duration" },
      "sm": { "value": "160ms", "type": "duration" },
      "md": { "value": "240ms", "type": "duration" },
      "lg": { "value": "480ms", "type": "duration" },
      "xl": { "value": "720ms", "type": "duration" }
    },
    "ease": {
      "out":      { "value": "cubic-bezier(0.22, 1, 0.36, 1)", "type": "cubicBezier" },
      "in-out":   { "value": "cubic-bezier(0.4, 0, 0.2, 1)",   "type": "cubicBezier" },
      "standard": { "value": "cubic-bezier(0.4, 0, 0.2, 1)",   "type": "cubicBezier" },
      "linear":   { "value": "linear",                         "type": "cubicBezier" }
    }
  },
  "breakpoint": {
    "sm":  { "value": "640px",  "type": "dimension" },
    "md":  { "value": "768px",  "type": "dimension" },
    "lg":  { "value": "1024px", "type": "dimension" },
    "xl":  { "value": "1280px", "type": "dimension" },
    "2xl": { "value": "1536px", "type": "dimension" }
  },
  "container": {
    "max":            { "value": "1200px", "type": "dimension" },
    "reading":        { "value": "680px",  "type": "dimension" },
    "gutter-mobile":  { "value": "16px",   "type": "dimension" },
    "gutter-desktop": { "value": "24px",   "type": "dimension" }
  }
}
